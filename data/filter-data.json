  "aggressiveEndpoints": [
    {
      "key": "all-third-party-pings",
      "ruleId": 6100,
      "priority": 1,
      "domainType": "thirdParty",
      "resourceTypes": [
        "ping"
      ]
    },
    {
      "key": "generic-third-party-beacon-image",
      "ruleId": 6110,
      "priority": 2,
      "domainType": "thirdParty",
      "regexFilter": "^https?://[^/]+/([^/?#]+/)*(tracking[-_]?pixel|track[-_]?pixel|pixel\\.gif|beacon\\.gif)([?#]|$)",
      "isUrlFilterCaseSensitive": false,
      "resourceTypes": [
        "image",
        "ping",
        "xmlhttprequest"
      ]
    },
    {
      "key": "generic-third-party-vast-vmap-path",
      "ruleId": 6120,
      "priority": 2,
      "domainType": "thirdParty",
      "regexFilter": "^https?://[^/]+/([^/?#]+/)*(vast[0-9]*|vmap)([/?#._-]|$)",
      "isUrlFilterCaseSensitive": false,
      "resourceTypes": [
        "sub_frame",
        "xmlhttprequest",
        "media",
        "other"
      ]
    },
    {
      "key": "generic-third-party-video-ad-path",
      "ruleId": 6130,
      "priority": 2,
      "domainType": "thirdParty",
      "regexFilter": "^https?://[^/]+/([^/?#]+/)*(video[-_]?ads?|ad[-_]?tag)([/?#._-]|$)",
      "isUrlFilterCaseSensitive": false,
      "resourceTypes": [
        "sub_frame",
        "xmlhttprequest",
        "media",
        "other"
      ]
    },
    {
      "key": "generic-third-party-video-tag-query",
      "ruleId": 6140,
      "priority": 2,
      "domainType": "thirdParty",
      "regexFilter": "^https?://[^/?#]+/[^#]*[?&](ad_?tag|adtag|vast|vmap)(_url)?=",
      "isUrlFilterCaseSensitive": false,
      "resourceTypes": [
        "sub_frame",
        "xmlhttprequest",
        "media",
        "other"
      ]
    },
    {
      "key": "generic-third-party-clickunder-script",
      "ruleId": 6150,
      "priority": 2,
      "domainType": "thirdParty",
      "regexFilter": "^https?://[^/]+/([^/?#]+/)*(clickunder|popunder)([._-][^/?#]+)?\\.js([?#]|$)",
      "isUrlFilterCaseSensitive": false,
      "resourceTypes": [
        "script"
      ]
    },
    {
      "key": "generic-miner-payload",
      "ruleId": 6160,
      "priority": 5,
      "regexFilter": "^https?://[^/]+/([^/?#]+/)*(coinhive|cryptonight|cryptoloot|webminer|webminepool)([._-][^/?#]+)?\\.(js|wasm)([?#]|$)",
      "isUrlFilterCaseSensitive": false,
      "resourceTypes": [
        "script",
        "xmlhttprequest",
        "other"
      ]
    },
    {
      "key": "google-tag-manager-container",
      "ruleId": 6170,
      "priority": 2,
      "domainType": "thirdParty",
      "urlFilter": "||www.googletagmanager.com/gtm.js",
      "resourceTypes": [
        "script"
      ]
    },
    {
      "key": "google-tag-manager-gtag",
      "ruleId": 6180,
      "priority": 2,
      "domainType": "thirdParty",
      "urlFilter": "||www.googletagmanager.com/gtag/js",
      "resourceTypes": [
        "script"
      ]
    },
    {
      "key": "meta-pixel",
      "ruleId": 6190,
      "priority": 2,
      "domainType": "thirdParty",
      "urlFilter": "||www.facebook.com/tr^",
      "resourceTypes": [
        "image",
        "xmlhttprequest",
        "ping"
      ]
    },
    {
      "key": "generic-third-party-pagead-path",
      "ruleId": 6200,
      "priority": 1,
      "domainType": "thirdParty",
      "urlFilter": "/pagead/",
      "resourceTypes": [
        "sub_frame",
        "script",
        "image",
        "xmlhttprequest"
      ]
    },
    {
      "key": "generic-third-party-adserver-path",
      "ruleId": 6210,
      "priority": 1,
      "domainType": "thirdParty",
      "urlFilter": "/adserver/",
      "resourceTypes": [
        "sub_frame",
        "script",
        "image",
        "xmlhttprequest"
      ]
    },
    {
      "key": "attribution-reporting-endpoint",
      "ruleId": 6220,
      "priority": 3,
      "urlFilter": "/.well-known/attribution-reporting/",
      "resourceTypes": [
        "xmlhttprequest",
        "ping",
        "other"
      ]
