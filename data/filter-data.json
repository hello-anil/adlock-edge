    "baseline": "AdLock 1.4.7 curated core, privacy, redirect, and navigation host lists",
    "reviewed": "2026-10-08",
    "policy": "Use dedicated advertising, tracking, popup, push, and mining hostnames; exclude shared media and storage CDNs. Broad endpoint patterns are strict-mode only.",
    "reviewScope": "Incremental review of observed network misses; the 2026-07-30 baseline was retained and was not independently re-audited.",
    "incrementalReview": {
      "evidence": "output/benchmarks/live-real-world-20261008.json",
      "easylistRevision": "436fee9573fb8942793cdb14607c20c656e1f36a",
      "additions": [
        {
          "category": "ad",
          "domains": ["ad-delivery.net"],
          "observed": "CNN Strict completed /px.gif requests in all three rounds.",
          "sources": ["https://github.com/easylist/easylist/blob/436fee9573fb8942793cdb14607c20c656e1f36a/easylist/easylist_adservers.txt"]
        },
        {
          "category": "ad",
          "domains": ["elb.the-ozone-project.com", "prebid.the-ozone-project.com"],
          "observed": "BBC loaded Ozone header-bidding scripts in all three Strict rounds and completed an /openrtb2/auction request in the disabled control.",
          "sources": ["https://docs.prebid.org/dev-docs/bidders/ozone", "https://github.com/easylist/easylist/blob/436fee9573fb8942793cdb14607c20c656e1f36a/easylist/easylist_adservers.txt"]
        },
        {
          "category": "tracker",
          "domains": ["id5-sync.com"],
          "observed": "BBC Strict completed cdn.id5-sync.com/api/1.0/id5-api.js in all three rounds and api.id5-sync.com/analytics/2010/id5-api-js in one round.",
          "sources": ["https://samples.id5.io/id5-api/basic", "https://wiki.id5.io/docs/initiate-cookie-sync-to-id5", "https://github.com/easylist/easylist/blob/436fee9573fb8942793cdb14607c20c656e1f36a/easylist/easylist_adservers.txt"]
        },
        {
          "category": "tracker",
          "domains": ["api.permutive.com", "cdn.permutive.com", "permutive.app"],
          "observed": "BBC and CNN Strict completed audience/identity/event API calls and Permutive SDK loads in all three rounds.",
          "sources": ["https://iabtechlab.github.io/trusted-server/guide/api-reference.html", "https://github.com/easylist/easylist/blob/436fee9573fb8942793cdb14607c20c656e1f36a/easyprivacy/easyprivacy_trackingservers_thirdparty.txt", "https://github.com/easylist/easylist/blob/436fee9573fb8942793cdb14607c20c656e1f36a/easyprivacy/easyprivacy_trackingservers_general.txt"]
        },
        {
          "category": "tracker",
          "domains": ["pub.doubleverify.com"],
          "observed": "BBC Strict completed /dvtag/ publisher measurement scripts and signals in all three rounds.",
          "sources": ["https://github.com/easylist/easylist/blob/436fee9573fb8942793cdb14607c20c656e1f36a/easylist/easylist_adservers.txt"]
        },
        {
          "category": "tracker",
          "domains": ["hotjar.io"],
          "observed": "d3ward events.hotjar.io/fakepage.html probes were not blocked by AdLock; all three Strict probes failed DNS resolution. This is a corroborated rule gap, not evidence of live ad traffic or a claimed traffic saving.",
          "sources": ["https://github.com/easylist/easylist/blob/436fee9573fb8942793cdb14607c20c656e1f36a/easyprivacy/easyprivacy_trackingservers_thirdparty.txt", "https://help.hotjar.com/hc/pt-br/articles/115011640307-Pol%C3%ADticas-de-Seguran%C3%A7a-de-Conte%C3%BAdo"]
        },
        {
          "category": "tracker",
          "domains": ["luckyorange.net"],
          "observed": "d3ward cs/upload/settings.luckyorange.net probes were not blocked by AdLock; Strict probes were aborted by the test page. Dedicated replay-host classification is independently supported by the maintained privacy list.",
          "sources": ["https://github.com/easylist/easylist/blob/436fee9573fb8942793cdb14607c20c656e1f36a/easyprivacy/easyprivacy_trackingservers_thirdparty.txt"]
        }
      ]
    }
